<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>space.seclume</groupId>
  <artifactId>seclume-parent</artifactId>
  <version>0.10.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>seclume</name>
  <description>
    JDBC drivers and a connection pool for PostgreSQL, MySQL, SQL Server and
    Oracle, whose secrets never appear as a String or char[] on the Java heap.
  </description>
  <url>https://seclume.space/</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>thomas-haas</id>
      <name>Thomas Haas</name>
      <url>https://seclume.space/</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/Seclume/seclume.git</connection>
    <developerConnection>scm:git:git@github.com:Seclume/seclume.git</developerConnection>
    <url>https://github.com/Seclume/seclume</url>
    <tag>HEAD</tag>
  </scm>

  <!-- GitHub Packages. Note for anybody reading this before adding the
       repository to their own build: GitHub requires a token even to *read*
       a public package, which is a property of the registry and not of this
       project. Maven Central is the address for a dependency that should
       just resolve. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/Seclume/seclume</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/Seclume/seclume</url>
    </snapshotRepository>
  </distributionManagement>

  <!-- seclume-tcp-core is deliberately absent: the transport that moves a live
       session between hosts is developed and licensed separately. -->
  <modules>
    <module>seclume-bom</module>
    <module>seclume-core</module>
    <module>seclume-tck</module>
    <module>seclume-postgresql</module>
    <module>seclume-mysql</module>
    <module>seclume-sqlserver</module>
    <module>seclume-oracle</module>
    <module>seclume-pool</module>
    <module>seclume-crac</module>
    <module>seclume-kafka</module>
    <module>seclume-redis</module>
    <module>seclume-quarkus</module>
    <module>seclume-spring-boot-starter</module>
    <module>seclume-bench</module>
    <module>seclume-verify</module>
    <module>seclume-spring-test</module>
    <module>seclume-heapcheck</module>
    <module>seclume-diff</module>
  </modules>

  <properties>
    <!-- Extra JVM arguments for test runs; see surefire below. -->
    <seclume.test.argLine></seclume.test.argLine>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <junit.version>5.11.4</junit.version>
    <jazzer.version>0.30.0</jazzer.version>
    <!-- Reproducible builds: a fixed timestamp in the archives. -->
    <project.build.outputTimestamp>2026-09-22T19:17:56Z</project.build.outputTimestamp>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Coverage-guided fuzzing: an ordinary build replays the saved
           inputs, JAZZER_FUZZ=1 searches for new ones. Tests only. -->
      <dependency>
        <groupId>com.code-intelligence</groupId>
        <artifactId>jazzer-junit</artifactId>
        <version>${jazzer.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- 3.13 ships an ASM that cannot read Java 25 class files
               (major 69) and fails on module-info already. -->
          <version>3.16.0</version>
          <configuration>
            <compilerArgs>
              <!-- "restricted" fires on every FFM downcall, which is the
                   normal case here and not worth a warning. Everything
                   else is an error. -->
              <arg>-Xlint:all,-restricted</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <!-- Tests run on the class path; the modules are still real
                 JPMS modules for whoever depends on them. -->
            <useModulePath>false</useModulePath>
            <!-- Empty until somebody sets it. It passes a system property
                 into the test JVM without touching this POM - for example
                 -Dseclume.test.argLine=-Dseclume.oracle.trace=true -->
            <argLine>--enable-native-access=ALL-UNNAMED ${seclume.test.argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
          <configuration>
            <!-- Implementation-Title / -Version in every jar, so that
                 Package.getImplementationVersion() - and space.seclume.Version
                 - can say which build is running. -->
            <archive>
              <manifest>
                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
              </manifest>
            </archive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>3.11.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.1.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      The whole fuzz corpus, instead of the sample an ordinary run takes.

      Four hand-written wire protocols are attacked by tens of thousands of
      broken frames here, and that is minutes of wall clock - right for a
      nightly job, wrong for the run somebody is waiting on. A suite people
      wait on is a suite people learn to skip, and a corpus that makes every
      build slow is a corpus that gets deleted in six weeks.

      So `mvn test` runs a fixed, deterministic sample of each corpus - the
      seeds themselves, the shapes that need no seed, and a spread across the
      rest - which keeps the harness alive and costs seconds. `mvn -Pfuzz
      test` runs all of it.
    -->
    <profile>
      <id>fuzz</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <seclume.fuzz.full>true</seclume.fuzz.full>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Sources and javadoc travel with a release, and only with a release: they
      cost a minute of build time that an ordinary `mvn install` has no reason
      to pay. Activated by `mvn -Prelease deploy`.

      Javadoc is set to fail on nothing rather than on everything, deliberately.
      The comments in this project are prose meant to be read in the source, and
      a missing @param on a private helper is not a reason to stop a release.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- A software bill of materials per module: what is in the jar and
               what it depends on. For seclume that list is short on purpose -
               the JDK and nothing else at runtime - and the SBOM is how a
               procurement check verifies it instead of taking it on trust. -->
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.1</version>
            <configuration>
              <outputFormat>json</outputFormat>
              <includeTestScope>false</includeTestScope>
            </configuration>
            <executions>
              <execution>
                <phase>package</phase>
                <goals><goal>makeBom</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      What changed in the public API since the last release: `mvn -Papicheck
      verify` compares every module's jar with the released one (from the local
      repository) and writes target/japicmp/. Before 1.0 it reports and does not
      fail - the API is still allowed to move, and the CHANGELOG says so - but
      every break is then a line somebody decided on, not one nobody noticed.
      At 1.0 breakBuildOnBinaryIncompatibleModifications goes to true.
    -->
    <profile>
      <id>apicheck</id>
      <properties>
        <seclume.api.baseline>0.9.0</seclume.api.baseline>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.siom79.japicmp</groupId>
            <artifactId>japicmp-maven-plugin</artifactId>
            <version>0.23.1</version>
            <configuration>
              <oldVersion>
                <dependency>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <version>${seclume.api.baseline}</version>
                  <type>jar</type>
                </dependency>
              </oldVersion>
              <parameter>
                <onlyModified>true</onlyModified>
                <!-- Not the user's API: the internal packages, and the protocol
                     layers under the JDBC classes, which are exported only
                     for the session-moving transport built on them. -->
                <excludes>
                  <exclude>*.internal.*</exclude>
                  <exclude>space.seclume.postgresql</exclude>
                  <exclude>space.seclume.postgresql.wire</exclude>
                  <exclude>space.seclume.mysql</exclude>
                  <exclude>space.seclume.mysql.wire</exclude>
                  <exclude>space.seclume.sqlserver.tds</exclude>
                  <exclude>space.seclume.oracle</exclude>
                  <exclude>space.seclume.oracle.net</exclude>
                </excludes>
                <ignoreMissingClasses>true</ignoreMissingClasses>
                <breakBuildOnBinaryIncompatibleModifications>false</breakBuildOnBinaryIncompatibleModifications>
                <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                <skipPomModules>true</skipPomModules>
              </parameter>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals><goal>cmp</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
