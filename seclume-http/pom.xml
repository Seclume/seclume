<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.11.0</version>
  </parent>

  <artifactId>seclume-http</artifactId>
  <name>seclume HTTP</name>
  <description>
    An HTTPS client for REST APIs whose API key, bearer token or password stays
    off the heap: the credential header is written from native memory into
    seclume's own TLS 1.3, request by request, and only ever to the one origin
    it belongs to. On its own, or as Spring's ClientHttpRequestFactory for
    RestClient and RestTemplate.</description>

  <properties>
    <spring.version>7.0.9</spring.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- private_key_jwt: the client assertion, signed with a key off the heap -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-jwt</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Spring's RestClient and RestTemplate: optional, only the request
         factory needs it. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <version>${spring.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- SeclumeSslSocketFactory under OkHttp, as the Kubernetes clients use it. -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>5.5.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
