<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.14.0-SNAPSHOT</version>
  </parent>

  <artifactId>seclume-heapdump</artifactId>
  <name>seclume Heap Dump</name>
  <description>
    Reads a heap dump for credentials - by the shapes they come in, and by
    what holds them - and writes a copy with every one it finds overwritten,
    checked again before it is let out. No dependency at all, so that an
    application can redact its own dumps without bringing the test kit
    along.</description>

  <dependencies>
    <!-- Tests only: the heap proof that a redaction searching for the
         application's own secrets leaves no copy of them behind. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
