<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.14.0-SNAPSHOT</version>
  </parent>

  <artifactId>seclume-logging</artifactId>
  <name>seclume Logging</name>
  <description>
    Masks the application's own secrets in log output before it is written,
    without holding any of them: each secret is kept as a keyed fingerprint
    and a keyed tag, the key in locked native memory. A Logback converter for
    the message and the stack trace; any other logger calls SecretMasker.</description>

  <properties>
    <logback.version>1.6.6</logback.version>
    <log4j.version>2.25.5</log4j.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The application's own Logback; only the converters need it. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- The application's own Log4j 2; only %redact needs it. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <version>${log4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- Log4j's index of its plugins, written by its own processor, so
               that %redact is found without a packages attribute. Only that
               processor: log4j-core brings others that want options. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.apache.logging.log4j</groupId>
                  <artifactId>log4j-core</artifactId>
                  <version>${log4j.version}</version>
                </path>
              </annotationProcessorPaths>
              <annotationProcessors>
                <annotationProcessor>org.apache.logging.log4j.core.config.plugins.processor.PluginProcessor</annotationProcessor>
              </annotationProcessors>
              <compilerArgs combine.self="override">
                <arg>-Xlint:all,-restricted,-processing</arg>
                <arg>-Werror</arg>
              </compilerArgs>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <proc>none</proc>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
