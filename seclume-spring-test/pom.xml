<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.9.0</version>
  </parent>

  <artifactId>seclume-spring-test</artifactId>
  <name>seclume Spring Data compatibility</name>
  <description>
    The evidence for the goal: a small Spring Boot application with entities,
    repositories and Flyway, running on the seclume drivers. Not published -
    this is the proof, not the work.</description>

  <properties>
    <spring.boot.version>4.1.1</spring.boot.version>
    <!-- Spring Boot 4 brings its own JUnit version and it has to win
         here: the parent project's is older, and the difference shows as a
         NoSuchMethodError in the middle of a test run. -->
    <junit.version>6.0.1</junit.version>
    <!-- Nowhere at all. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-spring-boot-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-postgresql</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mysql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-oracle</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-sqlserver</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>
    <!-- Spring Boot 4 moved the Flyway auto-configuration into a module
         of its own; flyway-core on the class path is no longer enough. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <version>11.13.3</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
      <version>11.13.3</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
      <version>11.13.3</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-sqlserver</artifactId>
      <version>11.13.3</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <version>${spring.boot.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Only for TestHosts: where the test databases are stands in one
         place and not in every test class. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Hibernate and Spring produce warnings that this project
               otherwise treats as errors; this module is the proof, not
               the work. -->
          <compilerArgs combine.self="override">
            <arg>-Xlint:none</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
