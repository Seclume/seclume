<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.14.0-SNAPSHOT</version>
  </parent>

  <artifactId>seclume-spring-boot-starter</artifactId>
  <name>seclume Spring Boot Starter</name>
  <description>
    Auto-configuration: add the dependency, fill in application.properties, done.</description>

  <properties>
    <spring.boot.version>4.1.1</spring.boot.version>
    <spring-framework.version>7.0.9</spring-framework.version>
    <tomcat.version>11.0.27</tomcat.version>
    <spring-cloud-aws.version>4.2.0</spring-cloud-aws.version>
    <aws-sdk.version>2.55.16</aws-sdk.version>
    <spring-ldap.version>4.1.1</spring-ldap.version>
    <sshd-core.version>2.20.0</sshd-core.version>
    <spring-integration.version>7.1.1</spring-integration.version>
    <jakarta.mail-api.version>2.1.5</jakarta.mail-api.version>
    <angus-mail.version>2.0.5</angus-mail.version>
    <elasticsearch-client.version>9.5.5</elasticsearch-client.version>
    <opensearch-client.version>3.10.0</opensearch-client.version>
    <spring-amqp.version>4.1.1</spring-amqp.version>
    <jnats.version>2.26.4</jnats.version>
    <spring-data-redis.version>4.1.1</spring-data-redis.version>
    <lettuce.version>7.8.0.RELEASE</lettuce.version>
    <micrometer.version>1.16.7</micrometer.version>
    <opentelemetry.version>1.67.0</opentelemetry.version>
    <jackson-annotations.version>2.22</jackson-annotations.version>
    <jackson.version>2.22.4</jackson.version>
    <jackson3.version>3.1.8</jackson3.version>
    <amqp-client.version>5.37.0</amqp-client.version>
    <netty.version>4.2.19.Final</netty.version>
  </properties>

  <!-- The optional clients bring what has known holes: Jackson 2.22.2
       (CVE-2026-89407 and others, fixed in 2.22.3), Jackson 3.1.0 (CVE-2026-68494,
       CVE-2026-54512, CVE-2026-89407, CVE-2026-68497, fixed in 3.1.7), amqp-client 5.31.0 (CVE-2026-63337, fixed in
       5.33.0, the version seclume-rabbitmq uses) and Netty 4.2.14 (CVE-2026-59901,
       fixed in 4.2.16). -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.rabbitmq</groupId>
        <artifactId>amqp-client</artifactId>
        <version>${amqp-client.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-pool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <version>${spring.boot.version}</version>
    </dependency>

    <!-- JdbcConnectionDetails - what Testcontainers' @ServiceConnection and
         Docker Compose support hand over. Optional: only looked at when it
         is there. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jdbc</artifactId>
      <version>${spring.boot.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- HTTPS APIs, optional: seclume.http.clients.<name>.url turns into a
         RestClient (and an @HttpExchange client) per name - only when
         seclume-http and Spring's web client are there. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-http</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
      <version>${spring-framework.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Private keys off the heap, optional: seclume.ssl.bundles.<name>
         turn into Spring SSL bundles whose key is in OpenSSL, and
         seclume.server.ssl.bundle gives Tomcat HTTPS with one of them. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-keys</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-tomcat</artifactId>
      <version>${spring.boot.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Boot 4.1.1 brings Tomcat 11.0.24, which has known critical
         vulnerabilities (CVE-2026-65182, -65905, -68525); 11.0.26 fixes them. -->
    <dependency>
      <groupId>org.apache.tomcat.embed</groupId>
      <artifactId>tomcat-embed-core</artifactId>
      <version>${tomcat.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- AWS, optional: seclume.aws.* turns into customizers that Spring Cloud
         AWS applies to every client it makes. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-aws</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-autoconfigure</artifactId>
      <version>${spring-cloud-aws.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>aws-core</artifactId>
      <version>${aws-sdk.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>http-auth-aws</artifactId>
      <version>${aws-sdk.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- LDAP, optional: seclume.ldap.url turns into Spring LDAP's context
         source (and so LdapTemplate and Spring Security's LDAP support). -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-ldap</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.ldap</groupId>
      <artifactId>spring-ldap-core</artifactId>
      <version>${spring-ldap.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- SSH, optional: seclume.ssh.key turns into an SshClient, and
         seclume.sftp.* into Spring Integration's SFTP session factory. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-ssh</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>${sshd-core.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-sftp</artifactId>
      <version>${spring-integration.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Mail, optional: seclume.mail.send / seclume.mail.read turn into a
         Jakarta Mail Session and a JavaMailSender - only when seclume-mail
         and Spring's mail support are there. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mail</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>${jakarta.mail-api.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>${angus-mail.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context-support</artifactId>
      <version>${spring-framework.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- MongoDB, optional: seclume.mongodb.url turns into the MongoClient -
         seclume's own driver when it is there, else the official driver on
         seclume's socket - and the reactive one with seclume-mongodb-reactive. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mongodb</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mongodb-driver</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mongodb-reactive</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Elasticsearch and OpenSearch, optional: seclume.elasticsearch.url and
         seclume.opensearch.url turn into the clients. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-elasticsearch</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>co.elastic.clients</groupId>
      <artifactId>elasticsearch-java</artifactId>
      <version>${elasticsearch-client.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.opensearch.client</groupId>
      <artifactId>opensearch-java</artifactId>
      <version>${opensearch-client.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- RabbitMQ, optional: seclume.rabbitmq.url turns into Spring AMQP's
         connection factory. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-rabbitmq</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
      <version>${spring-amqp.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- NATS, optional: seclume.nats.url turns into a Connection. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-nats</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.nats</groupId>
      <artifactId>jnats</artifactId>
      <version>${jnats.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Redis, optional: seclume.redis.url turns into Spring Data Redis's
         Lettuce connection factory. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-redis</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.data</groupId>
      <artifactId>spring-data-redis</artifactId>
      <version>${spring-data-redis.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.lettuce</groupId>
      <artifactId>lettuce-core</artifactId>
      <version>${lettuce.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- The drivers are optional: somebody who uses only PostgreSQL
         should not have to carry the other three. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-postgresql</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mysql</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-sqlserver</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-oracle</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- R2DBC, optional: with seclume-r2dbc on the class path the
         ConnectionFactory borrows from the seclume pool. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-r2dbc</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
      <version>${spring-framework.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Metrics and health, both optional. Without them on the class
         path the starter simply knows nothing about either. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
      <version>${micrometer.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Tracing, also optional. The API only: a span is created against
         whatever SDK the application already runs, and without one on the
         class path this bean is never defined. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
      <version>${opentelemetry.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- OpenTelemetry metrics, optional as well: with seclume.metrics.opentelemetry=true
         the events and every pool are measured through the application's SDK. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-opentelemetry</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Only so that javac can resolve the annotations on Spring's
         health classes; at runtime the Actuator brings them anyway. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>${jackson-annotations.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
      <version>${spring.boot.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- /actuator/seclume - only where the application has the actuator. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <version>${spring.boot.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- An SDK that keeps its spans in memory, so a test can read them. -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <version>${opentelemetry.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Boot's own mail auto-configuration, to show it steps aside. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-mail</artifactId>
      <version>${spring.boot.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${aws-sdk.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  
    <!-- Only for TestHosts: where the live PostgreSQL is stands in one place. -->
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
</dependencies>
</project>
