<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.10.0</version>
  </parent>

  <artifactId>seclume-crac</artifactId>
  <name>seclume CRaC</name>
  <description>
    Checkpoint and restore (CRaC, Lambda SnapStart) for seclume pools: every
    connection is given up before the checkpoint and opened afresh after the
    restore. A module of its own, so that the drivers and the pool keep their
    promise of no dependency beyond the JDK.</description>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-pool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The CRaC API: on a JDK without CRaC it does nothing, on one with it
         it forwards to jdk.crac. -->
    <dependency>
      <groupId>org.crac</groupId>
      <artifactId>crac</artifactId>
      <version>1.5.0</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
