<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>

  <artifactId>seclume-jasperreports-proof</artifactId>
  <name>seclume with embedded JasperReports - the proof</name>
  <description>
    JasperReports filling a report over a seclume connection, and a heap dump
    that shows the password is not in the process. Tests only; not published
    and not installed. JasperReports is LGPL-3.0 and is used here as a test
    dependency only: no seclume artifact depends on it or contains any of it.</description>

  <properties>
    <!-- Nowhere at all, like seclume-diff: this module is a measurement, not
         something that ships. Test scope alone would not be enough, because
         the module must not be installed either. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <jasperreports.version>7.0.8</jasperreports.version>
  </properties>

  <!-- JasperReports brings Jackson 2.18.8: CVE-2026-68497 (fixed in 2.18.10), CVE-2026-89407/-89425/
       -91776/-91777 (fixed in 2.18.11). -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>2.22.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-postgresql</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-pool</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- LGPL-3.0. Test scope in a module that is neither installed nor
         deployed: nothing of it is redistributed with seclume. -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports</artifactId>
      <version>${jasperreports.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
