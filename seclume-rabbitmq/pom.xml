<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.11.0</version>
  </parent>

  <artifactId>seclume-rabbitmq</artifactId>
  <name>seclume RabbitMQ</name>
  <description>
    RabbitMQ with the password or token off the heap: a ConnectionFactory for
    the official Java client (and so for Spring AMQP) whose connections are
    encrypted with seclume's own TLS 1.3 and whose PLAIN login is written from
    native memory into the handshake - the client itself only ever holds a
    placeholder.</description>

  <properties>
    <amqp-client.version>5.36.0</amqp-client.version>
    <spring.boot.version>4.1.1</spring.boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Only for the Spring AMQP test's versions. -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The application brings the client; this module configures it. -->
    <dependency>
      <groupId>com.rabbitmq</groupId>
      <artifactId>amqp-client</artifactId>
      <version>${amqp-client.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.amqp</groupId>
      <artifactId>spring-rabbit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
