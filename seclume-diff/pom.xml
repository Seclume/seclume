<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>space.seclume</groupId>
    <artifactId>seclume-parent</artifactId>
    <version>0.11.0-SNAPSHOT</version>
  </parent>

  <artifactId>seclume-diff</artifactId>
  <name>seclume differential tests</name>
  <description>
    The vendor driver as the oracle. The same server, the same values, both
    drivers - and every disagreement is a finding in one of them. Not
    published, and the only module in this project that depends on anybody
    else's code.</description>

  <properties>
    <!-- Nowhere at all: these drivers are the measuring stick, not a
         dependency of anything that ships. Test scope would not be enough on
         its own, because the module must not be installed either. -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>

    <pgjdbc.version>42.7.4</pgjdbc.version>
    <connectorj.version>9.1.0</connectorj.version>
    <mssqljdbc.version>12.8.1.jre11</mssqljdbc.version>
    <ojdbc.version>23.6.0.24.10</ojdbc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-postgresql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-mysql</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-sqlserver</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-oracle</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>space.seclume</groupId>
      <artifactId>seclume-tck</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- The oracles. Each one is somebody else's answer to the same
         question, which is the whole point: a hand-written test can only
         check what its author thought of, and these four have had twenty
         years of other people thinking of things. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${pgjdbc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${connectorj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${mssqljdbc.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${ojdbc.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
