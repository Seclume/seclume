target/
*.hprof

# Everything that describes one machine rather than the project: where its
# test databases are, and the passwords to reach them. One rule rather than a
# list, because a list is one forgotten entry away from committing a secret.
.local-*
.mssql-env.tmp
.oracle-env.tmp

# Jazzer: the corpus it grows while fuzzing (the findings worth keeping go
# to src/test/resources/**/*Inputs/ and are committed)
.cifuzz-corpus/

# Jazzer writes a reproducer here when a fuzz campaign finds something
crash-*
