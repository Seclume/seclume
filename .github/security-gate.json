{
  "_comment": [
    "The tests that carry seclume's security claims, by the CI job that runs them.",
    "security_gate.py reads the job's surefire reports and gives each one a status:",
    "PASS (run, nothing skipped, nothing failed), FAIL (failed, not run at all, or a",
    "method listed in 'methods' did not pass), SKIPPED (every case skipped),",
    "INCONCLUSIVE (some cases skipped) or NOT APPLICABLE",
    "(this platform is not one the test is for). Only PASS and NOT APPLICABLE let a",
    "build through: a skipped security test is never a passed one. Where a test may",
    "skip cases on a platform for a reason, 'skips' names the platform and the reason,",
    "and the status is PASS with the reason shown - never silently.",
    "'methods' are the test methods that carry the claim, each of which has to pass;",
    "gate_methods.py --write fills them in from the sources, --check keeps them in step.",
    "On a pull request the gate reads this file from the base branch (trusted_gate.sh)."
  ],
  "platforms": ["linux-x64", "linux-arm64", "windows-x64", "macos-arm64"],
  "groups": {
    "core": [
      {"test": "space.seclume.ForbiddenApiTest", "module": "seclume-core",
       "property": "no production code puts a secret on the heap without a marked reason",
       "methods": ["productionSourcesAvoidHeapPathsForSecrets"]},
      {"test": "space.seclume.ErrorMessageTest", "module": "seclume-core",
       "property": "no exception message carries a secret",
       "methods": ["everyThrownMessageSaysSomething"]},
      {"test": "space.seclume.secret.SecretScopeTest", "module": "seclume-core",
       "property": "a secret scope is zero after close, read back from its memory",
       "methods": ["closeZeroesTheSegment", "fromProviderFillsAndReportsLength",
                   "failingProviderReleasesTheScope", "closedScopeRefusesAccess",
                   "toStringHasNoContent", "allocationCounterCountsEveryScope",
                   "closingFromAnotherThreadIsRefusedAndTheOwnerCanStillWipe"]},
      {"test": "space.seclume.audit.AccessLogTest", "module": "seclume-core",
       "property": "the access log holds no secret, and a changed, removed, swapped or re-hashed entry is found",
       "methods": ["readsAreRecordedAsFactsAndTheLogHolds", "aFailedReadIsRecordedWithItsTypeOnly",
                   "aKeyRingIsRecorded", "aChangedEntryIsFound", "aRemovedEntryIsFound",
                   "swappedEntriesAreFound", "aRewrittenChainFailsAtTheNextSignature",
                   "anotherKeysSignaturesAreRefused",
                   "aCutOffTailHoldsAndIsVisibleOnlyAgainstACopyKeptElsewhere",
                   "aTornLastLineIsReportedAndNotWrittenOn", "reopeningContinuesTheChain",
                   "aRotatedLogStartsLaterAndSaysSo", "oneWriterPerFile",
                   "sinksGetEveryEntryAndAFailingOneStopsNothing", "theTimerSignsWithoutBeingAsked",
                   "withoutAnInstalledLogNothingIsWrittenAndNothingBreaks",
                   "whatIsNotAsciiIsEscapedAndStillVerifies", "theEntryParserIsStrict",
                   "garbageLinesAreReportedNotThrown", "aSampleForTheIndependentVerifier"]},
      {"test": "space.seclume.secret.AsyncSecretScopeTest", "module": "seclume-core",
       "property": "a scope wiped from another thread is wiped completely",
       "methods": ["timeoutThreadReleasesDefaultAllocation",
                   "providerScopeCanBeReadAndClosedAfterThreadHandoff",
                   "asyncWipeCoversUnusedCapacityInCallerOwnedSharedArena",
                   "everyConcurrentCloseReturnsOnlyAfterTheWipe"]},
      {"test": "space.seclume.secret.SecretLifecycleRegressionTest", "module": "seclume-core",
       "property": "errors, stack overflows and concurrent closes leave no scope open",
       "methods": ["anErrorFromTheProviderLeavesNothingOpen",
                   "aStackOverflowFromTheProviderLeavesNothingOpen",
                   "anExpiryThatThrowsDoesNotLoseTheScopeWhileRecording",
                   "anExpiryThatThrowsIsNotEvenAskedWhenNobodyRecords",
                   "anErrorFromTheRecordingClosesTheScopeItWouldHaveLost",
                   "aFailingProviderKeepsItsExceptionWhenTheRecordingFailsToo",
                   "aSharedScopeClosedFromManyThreadsAtOnceClosesExactlyOnce",
                   "aSharedScopeIsUnusableOnceAnotherThreadClosedIt",
                   "aScopeWrittenOnOneThreadIsReadAndWipedOnAnother"]},
      {"test": "space.seclume.secret.NativeAllocationFailureTest", "module": "seclume-core",
